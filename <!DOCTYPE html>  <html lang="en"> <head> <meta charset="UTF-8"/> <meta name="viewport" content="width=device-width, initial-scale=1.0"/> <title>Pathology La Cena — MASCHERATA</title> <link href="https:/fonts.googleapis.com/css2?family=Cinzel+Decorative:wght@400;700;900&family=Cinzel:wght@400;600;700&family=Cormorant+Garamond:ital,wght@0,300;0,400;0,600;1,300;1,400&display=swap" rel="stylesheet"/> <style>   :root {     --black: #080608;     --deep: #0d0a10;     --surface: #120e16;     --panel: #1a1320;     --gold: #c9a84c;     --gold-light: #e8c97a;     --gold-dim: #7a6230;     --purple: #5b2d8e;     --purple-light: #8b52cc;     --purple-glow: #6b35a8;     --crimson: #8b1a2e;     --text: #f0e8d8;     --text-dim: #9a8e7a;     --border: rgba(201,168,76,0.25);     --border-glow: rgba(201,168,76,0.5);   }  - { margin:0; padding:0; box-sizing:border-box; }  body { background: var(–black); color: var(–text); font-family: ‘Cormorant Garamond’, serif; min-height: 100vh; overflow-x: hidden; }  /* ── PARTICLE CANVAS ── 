async function sendAI(){
  const input=document.getElementById('ai-input');
  const msg=input.value.trim();
  if(!msg) return;
  input.value='';
  appendMsg(msg,'user');
  const loader=appendLoader();
  const systemPrompt=`You are the Oracle of the Mascherata — the mystical AI host of "Pathology La Cena: MASCHERATA", a grand masquerade dinner hosted by KIU Western Campus Biomedical Sciences students on October 31st 2026 at Western Meridean Hotel, Mbarara-Bushenyi, Uganda.

Event Details:
- Theme: MASCHERATA — "Masked in Mystery, United by Medicine"
- Date: 31st October 2026, 6:00 PM onwards
- Venue: Western Meridean Hotel, Mbarara-Bushenyi
- Tickets: Single 60,000 UGX | Couple 110,000 UGX (limited)
- Payment: MTN MoMo 13596432 (Solomon) → WhatsApp +256 705 265952 with transaction ID to receive Dinner Code
- Dress Code: Masquerade — elegant, masked, mysterious
- Tagline: "Come dressed. Be mysterious. Let's make it unforgettable."

Speak in a theatrical, elegant, slightly mysterious tone befitting a masquerade oracle. Be helpful, warm, and knowledgeable about the event. Also answer pathology/medicine questions with elegance. Keep responses concise (2-4 sentences max).`;

  try {
    const res=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        model:'claude-sonnet-4-6',
        max_tokens:1000,
        system:systemPrompt,
        messages:[{role:'user',content:msg}]
      })
    });
    const data=await res.json();
    loader.remove();
    const reply=data.content?.map(b=>b.text||'').join('')||"The oracle's vision is momentarily clouded... try again.";
    appendMsg(reply,'ai');
  } catch(e){
    loader.remove();
    appendMsg("The oracle's torch flickers... a connection was lost. Try again, masked one.",'ai');
  }
}

function appendMsg(text,role){
  const container=document.getElementById('ai-messages');
  const div=document.createElement('div');
  div.className='ai-msg'+(role==='user'?' user':'');
  div.innerHTML=`<div class="ai-avatar">${role==='user'?'🎭':'🕯️'}</div><div class="ai-bubble">${text}</div>`;
  container.appendChild(div);
  container.scrollTop=container.scrollHeight;
  return div;
}

function appendLoader(){
  const container=document.getElementById('ai-messages');
  const div=document.createElement('div');
  div.className='ai-msg';
  div.innerHTML=`<div class="ai-avatar">🕯️</div><div class="ai-bubble"><div class="ai-loading"><div class="ai-dot"></div><div class="ai-dot"></div><div class="ai-dot"></div></div></div>`;
  container.appendChild(div);
  container.scrollTop=container.scrollHeight;
  return div;
}

