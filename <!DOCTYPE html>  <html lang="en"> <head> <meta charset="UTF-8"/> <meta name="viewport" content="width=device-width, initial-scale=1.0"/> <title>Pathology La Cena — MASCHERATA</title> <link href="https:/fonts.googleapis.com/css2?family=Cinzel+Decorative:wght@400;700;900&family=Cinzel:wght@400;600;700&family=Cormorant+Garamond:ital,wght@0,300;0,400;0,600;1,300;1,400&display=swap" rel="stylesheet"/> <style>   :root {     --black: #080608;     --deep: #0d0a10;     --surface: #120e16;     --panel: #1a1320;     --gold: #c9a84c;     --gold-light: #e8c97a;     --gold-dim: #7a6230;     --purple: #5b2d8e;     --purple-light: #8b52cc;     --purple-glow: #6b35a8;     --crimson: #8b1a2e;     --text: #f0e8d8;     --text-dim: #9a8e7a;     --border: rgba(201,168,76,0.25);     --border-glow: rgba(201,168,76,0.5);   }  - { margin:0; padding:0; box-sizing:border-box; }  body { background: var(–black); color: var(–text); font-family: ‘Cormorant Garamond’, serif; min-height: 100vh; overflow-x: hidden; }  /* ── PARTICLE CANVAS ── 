function adminLogin(){
  const email=document.getElementById('admin-email').value.trim().toLowerCase();
  const pw=document.getElementById('admin-pw').value;
  const errBox=document.getElementById('admin-login-error');
  const match=ADMIN_ACCOUNTS.find(a=>a.email.toLowerCase()===email&&a.password===pw);
  if(match){
    state.adminLoggedIn=true;
    state.adminEmail=email;
    errBox.classList.add('hidden');
    document.getElementById('admin-login-wall').classList.add('hidden');
    document.getElementById('admin-dashboard').classList.remove('hidden');
    renderAdminDashboard();
    toast('Welcome, Committee Member 🎭','success');
  } else {
    errBox.textContent='Invalid email or password. Access denied.';
    errBox.classList.remove('hidden');
    document.getElementById('admin-pw').value='';
  }
}

function adminLogout(){
  state.adminLoggedIn=false;
  state.adminEmail=null;
  document.getElementById('admin-login-wall').classList.remove('hidden');
  document.getElementById('admin-dashboard').classList.add('hidden');
  document.getElementById('admin-email').value='';
  document.getElementById('admin-pw').value='';
  document.getElementById('admin-login-error').classList.add('hidden');
  document.getElementById('admin-nav-btn').style.display='none';
  history.replaceState(null,'',window.location.pathname);
  showPage('home');
}

function switchAdminTab(tab){
  document.querySelectorAll('.admin-tab').forEach((t,i)=>{
    const tabs=['overview','codes','attendees','polls-admin'];
    t.classList.toggle('active',tabs[i]===tab);
  });
  document.querySelectorAll('.admin-panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('tab-'+tab).classList.add('active');
  renderAdminDashboard();
}

function renderAdminDashboard(){
  if(!state.adminLoggedIn) return;
  const label=document.getElementById('admin-logged-as');
  if(label) label.textContent='Signed in as: '+state.adminEmail;
  // Stats
  const total=state.users.length;
  const ticketed=state.users.filter(u=>u.ticketNumber).length;
  const couples=state.users.filter(u=>u.cat==='couple').length;
  const singles=state.users.filter(u=>u.cat==='single').length;
  document.getElementById('stats-row').innerHTML=`
    <div class="stat-box"><div class="stat-num">${total}</div><div class="stat-label">Registered</div></div>
    <div class="stat-box"><div class="stat-num">${ticketed}</div><div class="stat-label">Ticketed</div></div>
    <div class="stat-box"><div class="stat-num">${singles}</div><div class="stat-label">Singles</div></div>
    <div class="stat-box"><div class="stat-num">${couples}</div><div class="stat-label">Couples</div></div>
    <div class="stat-box"><div class="stat-num">${state.codes.filter(c=>!c.used).length}</div><div class="stat-label">Unused Codes</div></div>`;

  // Recent
  const tbody=document.getElementById('recent-body');
  tbody.innerHTML=state.users.slice(-8).reverse().map(u=>`
    <tr><td>${u.fname} ${u.lname}</td><td>${u.cls}</td>
    <td><span class="badge badge-${u.cat}">${u.cat}</span></td>
    <td>${u.ticketNumber||'—'}</td>
    <td style="color:${u.ticketNumber?'var(--gold)':'var(--text-dim)'}">${u.ticketNumber?'✓ Active':'Pending'}</td></tr>`).join('');

  // Attendees
  document.getElementById('attendee-body').innerHTML=state.users.map(u=>`
    <tr><td>${u.fname} ${u.lname}</td><td style="font-size:0.8rem;color:var(--text-dim)">${u.email}</td>
    <td>${u.cls}</td><td><span class="badge badge-${u.cat}">${u.cat}</span></td>
    <td>${u.ticketNumber||'—'}</td>
    <td style="color:${u.ticketNumber?'var(--gold)':'var(--text-dim)'}">${u.ticketNumber?'✓ Active':'Pending'}</td></tr>`).join('');

  // Codes
  document.getElementById('code-list').innerHTML=state.codes.slice(-30).reverse().map(c=>{
    const exp=new Date(c.createdAt); exp.setMonth(exp.getMonth()+4);
    return `<li class="code-item">
      <div><div class="code-tag${c.used?' used':''}">${c.code}</div><div class="code-expires">Expires: ${exp.toLocaleDateString()}</div></div>
      <div class="code-meta">${c.used?`Used by ${c.usedBy}`:c.note||''}</div>
    </li>`;
  }).join('');

  // Polls admin list
  document.getElementById('existing-polls-list').innerHTML=state.polls.map(p=>`
    <li class="existing-poll-item">
      <div class="existing-poll-info">
        <div class="existing-poll-name">${p.emoji} ${p.title}</div>
        <div class="existing-poll-meta">${p.nominees.length} nominees · ${p.nominees.reduce((s,n)=>s+n.votes,0)} votes</div>
      </div>
      <div class="existing-poll-actions">
        <button class="btn-danger btn-sm" onclick="deletePoll('${p.id}')">Remove</button>
      </div>
    </li>`).join('') || '<li style="color:var(--text-dim);font-style:italic;padding:1rem">No polls created yet.</li>';
}

function generateCodes(){
  const note=document.getElementById('code-note').value.trim();
  const qty=parseInt(document.getElementById('code-qty').value);
  const created=[];
  for(let i=0;i<qty;i++){
    const code={
      id:uid(), code:'MSCRT-'+randomStr(5),
      note, used:false, usedBy:null, usedAt:null,
      createdAt:new Date().toISOString()
    };
    state.codes.push(code);
    created.push(code.code);
  }
  save(); renderAdminDashboard();
  toast(`${qty} code${qty>1?'s':''} generated ✦`,'success');
}

// POLL MANAGEMENT
let tempNominees=[];
function addNominee(){
  const v=document.getElementById('nominee-input').value.trim();
  if(!v) return;
  tempNominees.push({id:uid(),name:v,votes:0});
  document.getElementById('nominee-input').value='';
  renderTempNominees();
}
function renderTempNominees(){
  document.getElementById('nominees-admin-list').innerHTML=tempNominees.map((n,i)=>`
    <li>${n.name} <button class="btn-danger btn-sm" onclick="tempNominees.splice(${i},1);renderTempNominees()">×</button></li>`).join('');
}
function createPoll(){
  const title=document.getElementById('poll-title').value.trim();
  const emoji=document.getElementById('poll-emoji').value.trim()||'🗳️';
  if(!title) return toast('Enter a category title','error');
  if(tempNominees.length<2) return toast('Add at least 2 nominees','error');
  state.polls.push({id:uid(),title,emoji,nominees:[...tempNominees],userVotes:{},totalVotes:0});
  tempNominees=[];
  document.getElementById('poll-title').value='';
  document.getElementById('poll-emoji').value='';
  renderTempNominees();
  save(); renderAdminDashboard();
  toast('Poll "'+title+'" created! 🎭','success');
}
function deletePoll(id){
  state.polls=state.polls.filter(p=>p.id!==id);
  save(); renderAdminDashboard();
  toast('Poll removed','success');
}

