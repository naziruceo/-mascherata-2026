function showPage(page){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('page-'+page).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b=>{ if(b.textContent.toLowerCase().includes(page)||b.getAttribute('onclick')?.includes("'"+page+"'")) b.classList.add('active'); });
  if(page==='polls') renderPolls();
  if(page==='admin') renderAdminDashboard();
  window.scrollTo(0,0);
}

function showTicketTab(tab){
  ['register','login','code'].forEach(t=>{
    document.getElementById('ticket-tab-'+t).classList.toggle('hidden', t!==tab);
    document.getElementById('tab-'+t).style.borderColor = t===tab?'var(--gold)':'var(--gold-dim)';
    document.getElementById('tab-'+t).style.color = t===tab?'var(--gold)':'var(--text-dim)';
  });
  if(tab==='code'){
    if(state.currentUser){
      document.getElementById('code-login-wall').classList.add('hidden');
      document.getElementById('code-entry-form').classList.remove('hidden');
    } else {
      document.getElementById('code-login-wall').classList.remove('hidden');
      document.getElementById('code-entry-form').classList.add('hidden');
    }
    if(state.currentUser?.ticketNumber) showTicket();
  }
}

function scrollToRegister(cat){
  showTicketTab('register');
  if(cat) document.getElementById('reg-category').value=cat;
  document.getElementById('ticket-tab-register').scrollIntoView({behavior:'smooth'});
}

