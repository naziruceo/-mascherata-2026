function register(){
  const fname=document.getElementById('reg-fname').value.trim();
  const lname=document.getElementById('reg-lname').value.trim();
  const email=document.getElementById('reg-email').value.trim().toLowerCase();
  const cls=document.getElementById('reg-class').value;
  const cat=document.getElementById('reg-category').value;
  const pw=document.getElementById('reg-password').value;
  const cpw=document.getElementById('reg-confirm').value;
  if(!fname||!lname||!email||!cls||!pw){return toast('Please fill all fields','error');}
  if(pw!==cpw){return toast('Passwords do not match','error');}
  if(pw.length<6){return toast('Password must be at least 6 characters','error');}
  if(state.users.find(u=>u.email===email)){return toast('Email already registered','error');}
  const user={id:uid(),fname,lname,email,cls,cat,pw,ticketNumber:null,registeredAt:new Date().toISOString()};
  state.users.push(user);
  state.currentUser=user;
  save();
  toast('Welcome, '+fname+'! 🎭 Now enter your Dinner Code to unlock your ticket.','success');
  showTicketTab('code');
}

function login(){
  const email=document.getElementById('login-email').value.trim().toLowerCase();
  const pw=document.getElementById('login-password').value;
  const user=state.users.find(u=>u.email===email&&u.pw===pw);
  if(!user) return toast('Invalid email or password','error');
  state.currentUser=user;
  save();
  toast('Welcome back, '+user.fname+'! 🎭','success');
  showTicketTab('code');
  if(user.ticketNumber) showTicket();
}

// ═══════════════════════════════════════════════════
// CODE REDEMPTION
// ═══════════════════════════════════════════════════
function redeemCode(){
  if(!state.currentUser) return toast('Please login first','error');
  if(state.currentUser.ticketNumber) return toast('You already have a ticket!','success');
  const codeVal=document.getElementById('dinner-code-input').value.trim().toUpperCase();
  const codeObj=state.codes.find(c=>c.code===codeVal&&!c.used);
  if(!codeObj) return toast('Invalid or already used code','error');
  const expiry=new Date(codeObj.createdAt);
  expiry.setMonth(expiry.getMonth()+4);
  if(new Date()>expiry) return toast('This code has expired','error');
  // Mark used
  codeObj.used=true; codeObj.usedBy=state.currentUser.email; codeObj.usedAt=new Date().toISOString();
  // Assign ticket number
  const tNum='#MLC-'+String(Math.floor(1000+Math.random()*9000));
  const userIdx=state.users.findIndex(u=>u.email===state.currentUser.email);
  state.users[userIdx].ticketNumber=tNum;
  state.currentUser=state.users[userIdx];
  save();
  toast('🎭 Ticket unlocked! Welcome to the Mascherata!','success');
  showTicket();
}

function showTicket(){
  const u=state.currentUser;
  document.getElementById('td-name').textContent=u.fname+' '+u.lname;
  document.getElementById('td-class').textContent=u.cls;
  document.getElementById('td-category').textContent=u.cat==='couple'?'Couple 💫':'Single 🎭';
  document.getElementById('td-number').textContent=u.ticketNumber;
  document.getElementById('ticket-result').classList.remove('hidden');
  document.getElementById('ticket-result').scrollIntoView({behavior:'smooth'});
}

function printTicket(){ window.print(); }

