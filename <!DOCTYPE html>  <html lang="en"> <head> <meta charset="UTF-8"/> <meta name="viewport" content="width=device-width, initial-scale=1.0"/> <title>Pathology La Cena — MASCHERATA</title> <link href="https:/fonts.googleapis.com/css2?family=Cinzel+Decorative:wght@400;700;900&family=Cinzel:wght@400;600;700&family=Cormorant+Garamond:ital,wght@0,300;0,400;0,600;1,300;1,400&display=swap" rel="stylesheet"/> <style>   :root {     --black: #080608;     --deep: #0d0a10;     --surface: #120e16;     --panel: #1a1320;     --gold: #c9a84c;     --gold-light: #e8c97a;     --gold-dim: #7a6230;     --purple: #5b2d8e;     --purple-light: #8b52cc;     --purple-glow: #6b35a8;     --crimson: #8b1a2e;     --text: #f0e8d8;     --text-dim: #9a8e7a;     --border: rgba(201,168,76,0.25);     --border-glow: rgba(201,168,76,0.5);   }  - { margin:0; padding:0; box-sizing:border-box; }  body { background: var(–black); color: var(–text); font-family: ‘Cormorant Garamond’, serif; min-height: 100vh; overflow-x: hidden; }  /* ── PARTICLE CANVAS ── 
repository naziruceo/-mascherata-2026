// POLLS
// ═══════════════════════════════════════════════════
function renderPolls(){
  const container=document.getElementById('polls-container');
  const note=document.getElementById('polls-login-note');
  container.innerHTML='';
  if(!state.polls.length){
    container.innerHTML='<p style="color:var(--text-dim);font-style:italic;text-align:center;grid-column:1/-1">No polls live yet. Check back soon! 🎭</p>';
    return;
  }
  const canVote=!!state.currentUser?.ticketNumber;
  note.classList.toggle('hidden',canVote);
  state.polls.forEach(poll=>{
    const total=poll.nominees.reduce((s,n)=>s+n.votes,0);
    const userVote=state.currentUser?poll.userVotes[state.currentUser.id]:null;
    const card=document.createElement('div');
    card.className='poll-card';
    let nomHtml=poll.nominees.map(nom=>{
      const pct=total?Math.round(nom.votes/total*100):0;
      const voted=userVote===nom.id;
      return `<div class="nominee-item${voted?' voted':''}" onclick="${canVote?`castVote('${poll.id}','${nom.id}')`:''}" style="${!canVote?'cursor:default':''}">
        <div class="nominee-radio"><div class="nominee-radio-dot"></div></div>
        <span class="nominee-name">${nom.name}</span>
        <span class="nominee-count">${nom.votes}</span>
      </div>
      ${userVote?`<div class="vote-bar-wrap"><div class="vote-bar-label"><span>${nom.name}</span><span>${pct}%</span></div><div class="vote-bar-track"><div class="vote-bar-fill" style="width:${pct}%"></div></div></div>`:''}`;
    }).join('');
    card.innerHTML=`
      <div class="poll-card-header">
        <span class="poll-emoji">${poll.emoji||'🗳️'}</span>
        <div><div class="poll-card-title">${poll.title}</div><div class="poll-card-type">${poll.nominees.length} nominees</div></div>
      </div>
      <div class="nominee-list">${nomHtml}</div>
      <div class="poll-footer">
        <span class="poll-total">${total} vote${total!==1?'s':''} cast</span>
        ${userVote?'<span class="voted-badge">✓ Voted</span>':''}
      </div>`;
    container.appendChild(card);
  });
}

function castVote(pollId, nomId){
  if(!state.currentUser?.ticketNumber) return toast('You need a valid ticket to vote','error');
  const poll=state.polls.find(p=>p.id===pollId);
  if(!poll) return;
  const prev=poll.userVotes[state.currentUser.id];
  if(prev){
    if(prev===nomId) return;
    poll.nominees.find(n=>n.id===prev).votes--;
  }
  poll.nominees.find(n=>n.id===nomId).votes++;
  poll.userVotes[state.currentUser.id]=nomId;
  save();
  renderPolls();
  toast('Vote cast! 🎭','success');
}

