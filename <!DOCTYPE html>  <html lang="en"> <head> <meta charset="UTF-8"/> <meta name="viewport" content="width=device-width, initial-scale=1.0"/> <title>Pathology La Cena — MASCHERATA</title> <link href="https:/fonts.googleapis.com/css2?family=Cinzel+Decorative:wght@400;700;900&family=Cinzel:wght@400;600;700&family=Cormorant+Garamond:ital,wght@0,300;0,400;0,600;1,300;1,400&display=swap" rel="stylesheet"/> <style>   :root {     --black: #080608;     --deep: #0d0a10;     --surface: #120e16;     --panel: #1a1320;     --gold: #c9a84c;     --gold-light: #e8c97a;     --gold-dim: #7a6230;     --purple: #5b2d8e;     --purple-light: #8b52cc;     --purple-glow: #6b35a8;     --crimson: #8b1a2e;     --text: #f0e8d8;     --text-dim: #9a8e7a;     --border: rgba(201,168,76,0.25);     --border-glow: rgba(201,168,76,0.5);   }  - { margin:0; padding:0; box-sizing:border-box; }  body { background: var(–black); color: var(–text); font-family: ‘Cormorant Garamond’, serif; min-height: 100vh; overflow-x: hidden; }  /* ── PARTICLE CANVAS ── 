<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Pathology La Cena — MASCHERATA</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet"/>
<style>
  :root {
    --black: #080608;
    --deep: #0d0a10;
    --surface: #120e16;
    --panel: #1a1320;
    --gold: #c9a84c;
    --gold-light: #e8c97a;
    --gold-dim: #7a6230;
    --purple: #5b2d8e;
    --purple-light: #8b52cc;
    --purple-glow: #6b35a8;
    --crimson: #8b1a2e;
    --text: #f0e8d8;
    --text-dim: #9a8e7a;
    --border: rgba(201,168,76,0.25);
    --border-glow: rgba(201,168,76,0.5);
  }

- { margin:0; padding:0; box-sizing:border-box; }

body {
background: var(–black);
color: var(–text);
font-family: ‘Cormorant Garamond’, serif;
min-height: 100vh;
overflow-x: hidden;
}

/* ── PARTICLE CANVAS ── */
#canvas { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:0; opacity:0.4; }

/* ── LAYOUT ── */
.app { position:relative; z-index:1; }

/* ── NAV ── */
nav {
position: fixed; top:0; left:0; right:0; z-index:100;
background: rgba(8,6,8,0.92);
border-bottom: 1px solid var(–border);
backdrop-filter: blur(12px);
padding: 0 2rem;
display: flex; align-items:center; justify-content:space-between;
height: 64px;
}
.nav-logo {
font-family: ‘Cinzel Decorative’, serif;
font-size: 0.85rem;
color: var(–gold);
letter-spacing: 0.12em;
text-transform: uppercase;
}
.nav-logo span { color: var(–purple-light); }
.nav-links { display:flex; gap:0.25rem; }
.nav-btn {
background: none; border:none; cursor:pointer;
color: var(–text-dim); font-family:‘Cinzel’,serif;
font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase;
padding: 0.5rem 0.9rem; border-radius:2px;
transition: color 0.2s, background 0.2s;
}
.nav-btn:hover, .nav-btn.active {
color: var(–gold); background: rgba(201,168,76,0.08);
}
.nav-btn.admin-btn { color: var(–purple-light); }
.nav-btn.admin-btn:hover { color: var(–gold); background: rgba(91,45,142,0.15); }

/* ── PAGES ── */
.page { display:none; padding-top:64px; min-height:100vh; }
.page.active { display:block; }

/* ── HERO ── */
#page-home {
display:none;
background: radial-gradient(ellipse at 50% 0%, rgba(91,45,142,0.15) 0%, transparent 60%),
radial-gradient(ellipse at 80% 80%, rgba(201,168,76,0.06) 0%, transparent 50%),
var(–black);
}
#page-home.active { display:block; }

.hero {
min-height: calc(100vh - 64px);
display:flex; flex-direction:column; align-items:center; justify-content:center;
text-align:center; padding:3rem 2rem;
position:relative;
}

.mask-icon {
font-size: 3.5rem; margin-bottom:1rem;
filter: drop-shadow(0 0 20px rgba(201,168,76,0.6));
animation: float 4s ease-in-out infinite;
}
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }

.hero-eyebrow {
font-family:‘Cinzel’,serif; font-size:0.7rem; letter-spacing:0.35em;
color:var(–gold-dim); text-transform:uppercase; margin-bottom:1.5rem;
}
.hero-title {
font-family:‘Cinzel Decorative’,serif;
font-size: clamp(2.2rem,6vw,4.5rem);
font-weight:900; color:var(–gold);
line-height:1.05;
text-shadow: 0 0 40px rgba(201,168,76,0.4), 0 0 80px rgba(201,168,76,0.15);
margin-bottom:0.4rem;
}
.hero-subtitle {
font-family:‘Cinzel Decorative’,serif;
font-size: clamp(1rem,2.5vw,1.6rem);
color:var(–purple-light);
letter-spacing:0.2em; margin-bottom:1rem;
text-shadow: 0 0 30px rgba(139,82,204,0.5);
}
.hero-tagline {
font-style:italic; font-size:1.15rem; color:var(–text-dim);
letter-spacing:0.05em; margin-bottom:2.5rem;
}

.countdown {
display:flex; gap:1.5rem; justify-content:center;
margin-bottom:3rem; flex-wrap:wrap;
}
.cd-unit {
text-align:center;
background: rgba(201,168,76,0.06);
border:1px solid var(–border);
border-radius:4px; padding:1rem 1.4rem;
min-width:80px;
}
.cd-num {
font-family:‘Cinzel Decorative’,serif;
font-size:2rem; color:var(–gold); display:block;
text-shadow:0 0 20px rgba(201,168,76,0.5);
}
.cd-label { font-size:0.65rem; letter-spacing:0.2em; color:var(–text-dim); text-transform:uppercase; }

.event-details {
display:flex; gap:2rem; justify-content:center; flex-wrap:wrap;
margin-bottom:3rem;
}
.detail-pill {
border:1px solid var(–border); border-radius:2px;
padding:0.6rem 1.2rem; font-size:0.85rem; color:var(–text-dim);
letter-spacing:0.05em;
}
.detail-pill strong { color:var(–gold); }

.hero-cta { display:flex; gap:1rem; flex-wrap:wrap; justify-content:center; }

/* ── BUTTONS ── */
.btn-gold {
background: linear-gradient(135deg,#c9a84c,#e8c97a,#c9a84c);
color:#080608; border:none; cursor:pointer;
font-family:‘Cinzel’,serif; font-weight:700;
font-size:0.75rem; letter-spacing:0.15em; text-transform:uppercase;
padding:0.9rem 2rem; border-radius:2px;
transition:transform 0.2s, box-shadow 0.2s;
box-shadow:0 4px 20px rgba(201,168,76,0.3);
}
.btn-gold:hover { transform:translateY(-2px); box-shadow:0 8px 30px rgba(201,168,76,0.5); }

.btn-outline {
background:transparent; color:var(–gold);
border:1px solid var(–gold-dim); cursor:pointer;
font-family:‘Cinzel’,serif; font-size:0.75rem;
letter-spacing:0.15em; text-transform:uppercase;
padding:0.9rem 2rem; border-radius:2px;
transition:all 0.2s;
}
.btn-outline:hover { border-color:var(–gold); background:rgba(201,168,76,0.08); }

.btn-purple {
background:linear-gradient(135deg,#5b2d8e,#8b52cc);
color:#fff; border:none; cursor:pointer;
font-family:‘Cinzel’,serif; font-size:0.75rem;
letter-spacing:0.15em; text-transform:uppercase;
padding:0.9rem 2rem; border-radius:2px;
transition:all 0.2s;
box-shadow:0 4px 20px rgba(91,45,142,0.4);
}
.btn-purple:hover { transform:translateY(-2px); box-shadow:0 8px 30px rgba(91,45,142,0.6); }

.btn-sm {
padding:0.5rem 1rem; font-size:0.65rem;
}
.btn-danger {
background:rgba(139,26,46,0.3); color:#e06080;
border:1px solid rgba(139,26,46,0.5); cursor:pointer;
font-family:‘Cinzel’,serif; font-size:0.65rem;
letter-spacing:0.1em; text-transform:uppercase;
padding:0.4rem 0.8rem; border-radius:2px; transition:all 0.2s;
}
.btn-danger:hover { background:rgba(139,26,46,0.5); }

/* ── SECTION CONTAINER ── */
.section { padding:5rem 2rem; max-width:1100px; margin:0 auto; }
.section-title {
font-family:‘Cinzel Decorative’,serif;
font-size:clamp(1.4rem,3vw,2rem); color:var(–gold);
text-align:center; margin-bottom:0.5rem;
}
.section-line {
width:120px; height:1px; background:linear-gradient(90deg,transparent,var(–gold),transparent);
margin:0 auto 0.75rem;
}
.section-sub { text-align:center; color:var(–text-dim); font-style:italic; margin-bottom:3rem; font-size:1.05rem; }

/* ── TICKET PRICING ── */
.ticket-cards { display:flex; gap:1.5rem; flex-wrap:wrap; justify-content:center; }
.ticket-card {
border:1px solid var(–border); border-radius:4px;
padding:2rem; width:280px; text-align:center;
background:var(–panel); position:relative; overflow:hidden;
transition:transform 0.3s, box-shadow 0.3s;
}
.ticket-card::before {
content:’’; position:absolute; top:0; left:0; right:0; height:3px;
background:linear-gradient(90deg,transparent,var(–gold),transparent);
}
.ticket-card:hover { transform:translateY(-6px); box-shadow:0 20px 60px rgba(201,168,76,0.15); }
.ticket-card.featured::before { background:linear-gradient(90deg,transparent,var(–purple-light),transparent); }
.ticket-badge {
position:absolute; top:1rem; right:1rem;
background:var(–purple); color:#fff;
font-family:‘Cinzel’,serif; font-size:0.6rem; letter-spacing:0.1em;
padding:0.2rem 0.5rem; border-radius:2px; text-transform:uppercase;
}
.ticket-icon { font-size:2.5rem; margin-bottom:1rem; }
.ticket-type { font-family:‘Cinzel’,serif; font-size:0.8rem; letter-spacing:0.2em; color:var(–text-dim); text-transform:uppercase; margin-bottom:0.5rem; }
.ticket-price { font-family:‘Cinzel Decorative’,serif; font-size:2rem; color:var(–gold); margin-bottom:0.25rem; }
.ticket-note { font-size:0.8rem; color:var(–text-dim); font-style:italic; margin-bottom:1.5rem; }

.payment-info {
background:var(–panel); border:1px solid var(–border); border-radius:4px;
padding:2rem; margin-top:3rem; text-align:center;
}
.payment-info h3 { font-family:‘Cinzel’,serif; color:var(–gold); margin-bottom:1rem; letter-spacing:0.1em; }
.payment-step {
display:flex; align-items:flex-start; gap:1rem; text-align:left;
margin-bottom:0.75rem; font-size:0.95rem;
}
.step-num {
background:var(–gold); color:#080608;
font-family:‘Cinzel’,serif; font-weight:700; font-size:0.7rem;
min-width:24px; height:24px; border-radius:50%;
display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.highlight { color:var(–gold); font-weight:600; }
.purple-hl { color:var(–purple-light); }

/* ── FORMS ── */
.form-container {
max-width:520px; margin:0 auto;
background:var(–panel); border:1px solid var(–border);
border-radius:4px; padding:2.5rem; position:relative; overflow:hidden;
}
.form-container::before {
content:’’; position:absolute; top:0; left:0; right:0; height:2px;
background:linear-gradient(90deg,transparent,var(–gold),transparent);
}
.form-header { text-align:center; margin-bottom:2rem; }
.form-icon { font-size:2.5rem; margin-bottom:0.75rem; display:block; }
.form-title { font-family:‘Cinzel’,serif; font-size:1.2rem; color:var(–gold); letter-spacing:0.1em; }
.form-sub { font-size:0.9rem; color:var(–text-dim); font-style:italic; margin-top:0.25rem; }

.form-group { margin-bottom:1.25rem; }
label { display:block; font-family:‘Cinzel’,serif; font-size:0.65rem; letter-spacing:0.15em; color:var(–text-dim); text-transform:uppercase; margin-bottom:0.4rem; }
input, select, textarea {
width:100%; background:rgba(255,255,255,0.04);
border:1px solid rgba(201,168,76,0.2); border-radius:2px;
color:var(–text); font-family:‘Cormorant Garamond’,serif; font-size:1rem;
padding:0.7rem 1rem; transition:border 0.2s, box-shadow 0.2s; outline:none;
}
input:focus, select:focus, textarea:focus {
border-color:var(–gold-dim); box-shadow:0 0 0 2px rgba(201,168,76,0.1);
}
select option { background:var(–deep); color:var(–text); }
.form-row { display:flex; gap:1rem; }
.form-row .form-group { flex:1; }
.form-hint { font-size:0.78rem; color:var(–text-dim); font-style:italic; margin-top:0.3rem; }

.toggle-form { text-align:center; margin-top:1rem; font-size:0.9rem; color:var(–text-dim); }
.toggle-link { color:var(–gold); cursor:pointer; text-decoration:underline; }

/* ── TICKET DISPLAY ── */
.ticket-display {
max-width:600px; margin:2rem auto;
background:linear-gradient(145deg,#0d0a10,#1a1320);
border:2px solid var(–gold); border-radius:8px;
padding:2.5rem; position:relative; overflow:hidden; text-align:center;
}
.ticket-display::before {
content:’’; position:absolute; inset:0;
background:
radial-gradient(circle at 20% 20%, rgba(201,168,76,0.05) 0%, transparent 50%),
radial-gradient(circle at 80% 80%, rgba(91,45,142,0.08) 0%, transparent 50%);
}
.ticket-display-inner { position:relative; z-index:1; }
.ticket-corner { position:absolute; font-size:1.5rem; }
.ticket-corner.tl { top:1rem; left:1rem; }
.ticket-corner.tr { top:1rem; right:1rem; }
.ticket-corner.bl { bottom:1rem; left:1rem; }
.ticket-corner.br { bottom:1rem; right:1rem; }
.ticket-event-name { font-family:‘Cinzel Decorative’,serif; font-size:1.4rem; color:var(–gold); margin-bottom:0.25rem; }
.ticket-theme { font-family:‘Cinzel’,serif; font-size:0.9rem; color:var(–purple-light); letter-spacing:0.2em; margin-bottom:0.25rem; }
.ticket-divider { border:none; border-top:1px solid var(–border); margin:1rem 0; }
.ticket-holder-name { font-size:1.6rem; color:var(–text); font-style:italic; margin-bottom:0.5rem; }
.ticket-meta { display:flex; gap:2rem; justify-content:center; flex-wrap:wrap; margin-bottom:1rem; }
.ticket-meta-item { text-align:center; }
.ticket-meta-label { font-family:‘Cinzel’,serif; font-size:0.6rem; letter-spacing:0.15em; color:var(–text-dim); text-transform:uppercase; display:block; }
.ticket-meta-value { color:var(–gold); font-family:‘Cinzel’,serif; font-size:0.95rem; }
.ticket-number {
font-family:‘Cinzel Decorative’,serif; font-size:2.5rem; color:var(–gold);
text-shadow:0 0 20px rgba(201,168,76,0.5);
letter-spacing:0.1em; margin:0.5rem 0;
}
.ticket-number-label { font-family:‘Cinzel’,serif; font-size:0.6rem; letter-spacing:0.2em; color:var(–text-dim); text-transform:uppercase; }
.ticket-valid { font-family:‘Cinzel’,serif; font-size:0.7rem; letter-spacing:0.1em; color:var(–purple-light); text-transform:uppercase; margin-top:0.5rem; }
.ticket-venue { font-style:italic; color:var(–text-dim); font-size:0.9rem; margin-top:0.25rem; }

/* ── POLLS ── */
.polls-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1.5rem; }
.poll-card {
background:var(–panel); border:1px solid var(–border); border-radius:4px;
padding:1.5rem; transition:box-shadow 0.3s;
}
.poll-card:hover { box-shadow:0 8px 30px rgba(201,168,76,0.1); }
.poll-card-header { display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem; }
.poll-emoji { font-size:1.8rem; }
.poll-card-title { font-family:‘Cinzel’,serif; font-size:0.9rem; letter-spacing:0.05em; color:var(–gold); }
.poll-card-type { font-size:0.75rem; color:var(–text-dim); font-style:italic; }
.nominee-list { margin-bottom:1rem; }
.nominee-item {
display:flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem;
padding:0.5rem 0.75rem; border-radius:2px; cursor:pointer;
border:1px solid transparent; transition:all 0.2s;
font-size:0.95rem;
}
.nominee-item:hover { border-color:var(–border); background:rgba(201,168,76,0.05); }
.nominee-item.voted { border-color:var(–gold-dim); background:rgba(201,168,76,0.08); }
.nominee-radio {
width:14px; height:14px; border-radius:50%;
border:2px solid var(–gold-dim); flex-shrink:0; display:flex;
align-items:center; justify-content:center; transition:all 0.2s;
}
.nominee-item.voted .nominee-radio { background:var(–gold); border-color:var(–gold); }
.nominee-radio-dot { width:6px; height:6px; border-radius:50%; background:#080608; display:none; }
.nominee-item.voted .nominee-radio-dot { display:block; }
.nominee-name { flex:1; }
.nominee-count { font-family:‘Cinzel’,serif; font-size:0.7rem; color:var(–text-dim); }
.vote-bar-wrap { margin-bottom:0.3rem; }
.vote-bar-label { display:flex; justify-content:space-between; font-size:0.75rem; color:var(–text-dim); margin-bottom:0.2rem; }
.vote-bar-track { height:4px; background:rgba(255,255,255,0.06); border-radius:2px; overflow:hidden; }
.vote-bar-fill { height:100%; background:linear-gradient(90deg,var(–gold-dim),var(–gold)); border-radius:2px; transition:width 0.4s; }
.poll-footer { display:flex; align-items:center; justify-content:space-between; margin-top:1rem; }
.poll-total { font-size:0.75rem; color:var(–text-dim); font-style:italic; }
.voted-badge { font-family:‘Cinzel’,serif; font-size:0.65rem; letter-spacing:0.1em; color:var(–gold); text-transform:uppercase; }

.login-required-note { text-align:center; color:var(–text-dim); font-style:italic; font-size:0.95rem; margin-top:2rem; }
.login-required-note .toggle-link { color:var(–gold); cursor:pointer; text-decoration:underline; }

/* ── ADMIN ── */
.admin-header {
background:linear-gradient(135deg,rgba(91,45,142,0.2),rgba(201,168,76,0.05));
border-bottom:1px solid var(–border); padding:2rem;
text-align:center;
}
.admin-tabs { display:flex; border-bottom:1px solid var(–border); background:var(–deep); }
.admin-tab {
padding:1rem 1.5rem; cursor:pointer; font-family:‘Cinzel’,serif;
font-size:0.7rem; letter-spacing:0.15em; text-transform:uppercase;
color:var(–text-dim); border-bottom:2px solid transparent;
transition:all 0.2s;
}
.admin-tab.active { color:var(–gold); border-bottom-color:var(–gold); }
.admin-content { padding:2rem; max-width:1200px; margin:0 auto; }
.admin-panel { display:none; }
.admin-panel.active { display:block; }

.admin-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
@media(max-width:700px) { .admin-grid { grid-template-columns:1fr; } .form-row { flex-direction:column; } }

.admin-card {
background:var(–panel); border:1px solid var(–border); border-radius:4px; padding:1.5rem;
}
.admin-card-title { font-family:‘Cinzel’,serif; color:var(–gold); font-size:0.85rem; letter-spacing:0.1em; text-transform:uppercase; margin-bottom:1rem; }

.code-list { list-style:none; max-height:280px; overflow-y:auto; }
.code-item {
display:flex; align-items:center; justify-content:space-between;
padding:0.6rem 0; border-bottom:1px solid rgba(255,255,255,0.04);
font-size:0.85rem;
}
.code-tag {
font-family:‘Cinzel’,serif; font-size:0.75rem;
background:rgba(201,168,76,0.1); color:var(–gold);
padding:0.2rem 0.6rem; border-radius:2px; letter-spacing:0.05em;
}
.code-tag.used { background:rgba(139,26,46,0.15); color:#e06080; text-decoration:line-through; }
.code-meta { font-size:0.7rem; color:var(–text-dim); }
.code-expires { font-size:0.65rem; color:var(–text-dim); font-style:italic; }

.attendee-table { width:100%; border-collapse:collapse; font-size:0.85rem; }
.attendee-table th {
font-family:‘Cinzel’,serif; font-size:0.65rem; letter-spacing:0.15em;
color:var(–text-dim); text-transform:uppercase; padding:0.75rem 0.5rem;
border-bottom:1px solid var(–border); text-align:left;
}
.attendee-table td { padding:0.7rem 0.5rem; border-bottom:1px solid rgba(255,255,255,0.04); vertical-align:middle; }
.attendee-table tr:last-child td { border-bottom:none; }
.badge {
font-family:‘Cinzel’,serif; font-size:0.6rem; letter-spacing:0.08em;
padding:0.2rem 0.5rem; border-radius:2px; text-transform:uppercase;
}
.badge-single { background:rgba(201,168,76,0.1); color:var(–gold); }
.badge-couple { background:rgba(91,45,142,0.2); color:var(–purple-light); }

.stat-row { display:flex; gap:1rem; margin-bottom:1.5rem; flex-wrap:wrap; }
.stat-box {
flex:1; min-width:100px; background:var(–surface); border:1px solid var(–border);
border-radius:4px; padding:1rem; text-align:center;
}
.stat-num { font-family:‘Cinzel Decorative’,serif; font-size:1.8rem; color:var(–gold); }
.stat-label { font-size:0.7rem; color:var(–text-dim); font-family:‘Cinzel’,serif; letter-spacing:0.1em; text-transform:uppercase; }

/* ── POLL ADMIN ── */
.poll-admin-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
@media(max-width:700px){ .poll-admin-grid { grid-template-columns:1fr; } }
.nominee-input-row { display:flex; gap:0.5rem; margin-bottom:0.5rem; }
.nominee-input-row input { flex:1; }
.nominees-list-admin { list-style:none; margin-top:0.5rem; }
.nominees-list-admin li {
display:flex; align-items:center; justify-content:space-between;
padding:0.4rem 0.6rem; background:rgba(255,255,255,0.03);
border-radius:2px; margin-bottom:0.25rem; font-size:0.85rem;
}

.existing-polls-list { list-style:none; }
.existing-poll-item {
display:flex; align-items:center; justify-content:space-between;
padding:0.75rem; background:rgba(255,255,255,0.03); border-radius:2px;
margin-bottom:0.5rem; border:1px solid rgba(255,255,255,0.05);
}
.existing-poll-info { flex:1; }
.existing-poll-name { font-family:‘Cinzel’,serif; color:var(–text); font-size:0.85rem; }
.existing-poll-meta { font-size:0.75rem; color:var(–text-dim); font-style:italic; }
.existing-poll-actions { display:flex; gap:0.5rem; }

/* ── MASCHERATA AI ── */
.ai-chat-container {
max-width:700px; margin:0 auto;
background:var(–panel); border:1px solid var(–border); border-radius:4px;
